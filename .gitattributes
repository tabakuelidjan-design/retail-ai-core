# Pinned font files and their licence texts are verified byte for byte against SHA-256: never convert line endings.
resources/fonts/** -text
# Official validation artifacts are third-party, verbatim, hash-pinned (vendor/MANIFEST.json): Git must never convert their line endings or diff them as text.
vendor/** -text -diff
# Golden Core journal produced by the ORIGINAL code (f721e49): replayed by test/core-reliability.test.js; hashes cover content, never convert line endings.
test/fixtures/core-journal-v1/** -text
# Shell scripts run in Linux containers (deploy/sourcing/docker-entrypoint.sh): a CRLF shebang makes the container fail with "exec ... no such file or directory". Always LF, whatever core.autocrlf says.
*.sh text eol=lf
deploy/**/Dockerfile* text eol=lf
