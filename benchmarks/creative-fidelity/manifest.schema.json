{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nordla.local/schemas/creative-fidelity-manifest-v0.json",
  "title": "Nordla Creative Fidelity Benchmark Manifest V0",
  "type": "object",
  "required": ["benchmark_id", "merchant_id", "cases"],
  "properties": {
    "benchmark_id": {"type": "string", "minLength": 1},
    "merchant_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "product_id", "task", "source_refs", "expected_invariants"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "product_id": {"type": "string", "minLength": 1},
          "task": {"enum": ["BACKGROUND_SWAP", "PREMIUM_AD", "IN_CONTEXT", "EXTERNAL_EDIT", "COHERENT_SET"]},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "instruction": {"type": ["string", "null"]},
          "expected_invariants": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
