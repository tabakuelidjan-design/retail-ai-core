    "asr:e2e": "node test/e2e/asr-canon.e2e.js",
    "sync:backfill": "node --env-file=.env src/sync/index.js orders --full-history",
    "analytics-premium": "node --env-file=.env src/analytics-premium/server/serve.js",
    "marketing-creative:smoke": "node src/marketing-creative/alibaba/smoke-cli.js",
