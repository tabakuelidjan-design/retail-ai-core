    "sourcing": "node src/sourcing/server/index.js",
    "sourcing:phone": "node src/sourcing/server/phone.js",
    "sourcing:e2e": "node test/e2e/sourcing-pwa.e2e.js",
    "sourcing:e2e:tunnel": "node test/e2e/real-tunnel.e2e.js",
    "sourcing:e2e:recovery": "node test/e2e/sourcing-case-recovery.e2e.js",
    "sourcing:e2e:reconnect": "node test/e2e/sourcing-recovery-reconnect.e2e.js",
    "sourcing:e2e:v1": "node test/e2e/sourcing-v1-field.e2e.js",
