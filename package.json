  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "bidi-js": "1.1.0",
    "harfbuzzjs": "1.6.3",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.20.2",
    "saxon-js": "2.7.0",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "xslt3": "2.7.0"
  }
}
