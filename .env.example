# Copy to .env and fill in real values locally. Never commit .env (already
# gitignored). This file documents variable NAMES only - no real values,
# ever, not even example-looking ones that could be mistaken for real.

# The store's myshopify.com domain (not the custom domain).
SHOPIFY_SHOP_DOMAIN=

# From the Shopify Dev Dashboard app's API credentials page (Settings tab).
# Apps created via the Dev Dashboard (mandatory for all new custom apps
# since 2026-01-01) authenticate via the OAuth 2.0 client credentials grant -
# there is no static long-lived token to copy anymore. See
# docs/security/shopify-auth.md for exact setup steps.
SHOPIFY_CLIENT_ID=
# SECRET - server-side only.
SHOPIFY_CLIENT_SECRET=

# Shopify Admin API version this codebase targets. Pin explicitly; bump
# deliberately, don't float on "latest".
SHOPIFY_API_VERSION=2024-10

# Supabase project REST URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Service role key - full read/write access, SERVER-SIDE ONLY. Never send to
# a browser/frontend, never commit, never print in logs. See
# docs/security/shopify-auth.md for why this is currently required and what
# a lower-privilege alternative would need.
SUPABASE_SERVICE_ROLE_KEY=

# The Nordla tenant this service works for (merchants.id, a UUID) - required by Core sync and Finance (ADR 0003).
# Shopify never decides the tenant: its connector (merchant_connectors, kind shopify) must belong to this merchant.
NORDLA_MERCHANT_ID=

# IANA timezone for this merchant's "business day" boundary, used only by
# the inventory snapshot cadence (one snapshot per variant/location per
# local day). Merchant configuration, not architecture - optional, defaults
# to UTC if unset. HABB's value: Europe/Brussels
MERCHANT_TIMEZONE=

# Phase 2E pseudonymous customer keys: set SYNC_CUSTOMER_KEY=1 only after read_customers is live on the token.
# CUSTOMER_HASH_KEY must be a local random secret of at least 32 characters; never commit it.
CUSTOMER_HASH_KEY=
SYNC_CUSTOMER_KEY=

# Finance dashboard (local). Login token is generated into your .env on first run; never commit it.
FINANCE_DASHBOARD_TOKEN=
FINANCE_PORT=4310

# Provider Provisioning & Live Connections V1 - NAMES ONLY, never a value in Git or in chat.
# The OAuth app credentials come from each provider's developer console (see docs/runbooks/provider-app-registration.md); set them in the
# deployment secret store (never in a file that is committed). The redirect URI must be https, registered identically at the provider,
# static (no query string, no fragment). Tokens themselves are NEVER configured here: they live in Supabase Vault.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_API_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Set to true only once TikTok has audited the app (until then posts are limited to private visibility).
TIKTOK_CLIENT_AUDITED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Local callback receiver of the CLI (defaults 127.0.0.1:8788). A provider that needs a public https redirect URI needs a real deployment.
PROVIDER_CALLBACK_HOST=
PROVIDER_CALLBACK_PORT=
