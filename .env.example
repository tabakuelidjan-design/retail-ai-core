# Copy to .env and fill in real values. Never commit .env (already gitignored).

# The store's myshopify.com domain (not the custom domain). Not secret by itself,
# but kept here so it's never hardcoded next to the token.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API access token from a custom app installed on the store, read-only
# scopes only (read_products, read_inventory, read_locations). See
# docs/security/shopify-auth.md for exactly how to create it. SECRET.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API version this codebase targets. Pin explicitly; bump
# deliberately, don't float on "latest".
SHOPIFY_API_VERSION=2024-10

# Supabase project REST URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service role key - full read/write access, SERVER-SIDE ONLY. Never send to
# a browser/frontend. SECRET.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
