{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nordla://schemas/branding/brand-memory-v1",
  "title": "Nordla Brand Memory V1 (normalized document shape)",
  "description": "Structural contract of a normalized Brand Memory. Cross-field rules (type x operator matrix, value shapes, Core binding, token name format, duplicate colors) live in code and are covered by tests. This schema is executed in tests by validateSchemaSubset (a strict subset validator, not a general JSON Schema implementation) and checked against the code constants for drift.",
  "type": "object",
  "required": [
    "id",
    "merchant_id",
    "version",
    "status",
    "created_at",
    "supersedes_id",
    "core_ref",
    "identity_references",
    "design_tokens",
    "hard_rules",
    "semantic_context",
    "external_references",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "merchant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "APPROVED",
        "SUPERSEDED"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_ref": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "identity_references": {
      "type": "object",
      "required": [
        "primary_logo_ref",
        "approved_logo_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_logo_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_logo_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "uniqueItems": true,
          "maxItems": 50
        }
      }
    },
    "design_tokens": {
      "type": "object",
      "required": [
        "colors",
        "typography"
      ],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typography_token"
          }
        }
      }
    },
    "hard_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hard_rule"
      }
    },
    "semantic_context": {
      "type": "object",
      "required": [
        "voice_traits",
        "do",
        "dont",
        "brand_style_summary",
        "on_brand_examples",
        "off_brand_examples"
      ],
      "additionalProperties": false,
      "properties": {
        "voice_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "do": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "brand_style_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "on_brand_examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "off_brand_examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 10
        }
      }
    },
    "external_references": {
      "type": "object",
      "required": [
        "production_asset_refs",
        "claim_refs",
        "policy_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "production_asset_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^claim://\\S+$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^external-policy://\\S+$"
          },
          "uniqueItems": true,
          "maxItems": 50
        }
      }
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "decision_event_id",
        "approved_by",
        "approver_role",
        "approved_at",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_event_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approver_role": {
          "enum": [
            "OWNER",
            "AUTHORIZED_REVIEWER"
          ]
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "typography_token": {
      "type": "object",
      "required": [
        "family",
        "weights"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    },
    "hard_rule": {
      "type": "object",
      "required": [
        "id",
        "rule_type",
        "subject",
        "operator",
        "value",
        "severity",
        "scope",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule_type": {
          "enum": [
            "ASSET_REF",
            "COLOR",
            "TYPOGRAPHY",
            "TEXT",
            "CLAIM_REF",
            "EXTERNAL_GATE"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "EQUALS",
            "ONE_OF",
            "CONTAINS",
            "NOT_CONTAINS",
            "REQUIRED",
            "STATUS_IN"
          ]
        },
        "value": {
          "description": "Shape depends on rule_type and operator; enforced in code (HARD_RULE_MATRIX + value normalizers)."
        },
        "severity": {
          "enum": [
            "BLOCK",
            "REVIEW"
          ]
        },
        "scope": {
          "enum": [
            "GLOBAL",
            "TEXT",
            "IMAGE",
            "VIDEO",
            "DOCUMENT"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^(brand-core|decision|approved-asset|claim|external-policy)://\\S+$"
        }
      }
    }
  }
}
