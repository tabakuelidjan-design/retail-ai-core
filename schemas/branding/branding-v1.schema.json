{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nordla.local/schemas/branding/branding-v1.schema.json",
  "title": "Nordla Branding V1 contract bundle",
  "type": "object",
  "$defs": {
    "documentRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "evidence_kind", "statement", "source", "completeness"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["FACT", "INFERENCE", "HYPOTHESIS"]},
        "statement": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["system", "observed_at"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "ref": {"type": ["string", "null"]},
            "observed_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "hardRule": {
      "type": "object",
      "required": ["id", "rule_type", "subject", "enforcement", "severity", "constraint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_type": {"enum": ["LOGO", "COLOR", "TYPOGRAPHY", "WORDING", "CLAIM", "VISUAL", "TONE", "PRODUCT_FIDELITY", "ASSET_USAGE", "LAYOUT"]},
        "subject": {"type": "string", "minLength": 1},
        "enforcement": {"enum": ["DETERMINISTIC", "QUALITATIVE", "HYBRID"]},
        "severity": {"enum": ["BLOCK", "REVIEW"]},
        "constraint": {
          "type": "object",
          "required": ["operator", "value"],
          "properties": {
            "operator": {"enum": ["EQUALS", "ONE_OF", "NOT_ONE_OF", "CONTAINS", "NOT_CONTAINS", "RANGE", "REFERENCE", "CUSTOM"]},
            "value": {}
          },
          "additionalProperties": false
        },
        "scope": {"type": "string"},
        "source_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": {"const": "1.0"}
  },
  "additionalProperties": true
}
