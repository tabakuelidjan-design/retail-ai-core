# Copy to deploy/sourcing/.env ON THE SERVER ONLY (never committed: .env is git-ignored). No real value belongs in this example.
SOURCING_DOMAIN=sourcing.example.com
SOURCING_ALLOWED_HOSTS=sourcing.example.com
SOURCING_MERCHANT_ID=habb
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOURCING_TOKEN=
# The owner's login in front of everything. Hash with:  docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'your long password'
SOURCING_OWNER_USER=owner
SOURCING_OWNER_PASSWORD_HASH=
# Encrypts every backup archive. Keep a copy OFF the server (password manager + paper): without it no backup can be restored.
SOURCING_BACKUP_PASSPHRASE=
